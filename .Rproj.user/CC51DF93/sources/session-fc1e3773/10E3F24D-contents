## Project Overview

A spatial decision-support framework for assessing urban microclimates and thermal exposure to identify priority locations for blue-green infrastructure interventions.

## Project Deliverables

### Interactive Spatial Map

```{r}
#| echo: false
#| message: false
#| warning: false

library(sf)
library(leaflet)
library(htmlwidgets)

# 1. Read GeoJSON and transform CRS to WGS84 for Leaflet
malmo <- st_read("data/CoolNet.geojson", quiet = TRUE) %>% 
  st_transform(crs = 4326)

# 2. Define color palettes
pal_mcda  <- colorNumeric("YlOrRd", domain = malmo$MCDA.Score)
pal_uhi   <- colorNumeric("Reds",   domain = malmo$UHI_mean)
pal_ndvi  <- colorNumeric("Greens", domain = malmo$NVDI_mean)
pal_nbdi  <- colorNumeric("YlOrBr", domain = malmo$NBDI_mean)
pal_inc   <- colorNumeric("Blues",  domain = malmo$Income)
pal_water <- colorNumeric("PuBu",   domain = malmo$Dist_Water)

# 3. Build Leaflet Map
leaflet(malmo) %>%
  addProviderTiles(providers$CartoDB.Positron) %>%
  
  # Layer 1: MCDA Priority Score
  addPolygons(
    group = "MCDA Priority Score",
    fillColor = ~pal_mcda(MCDA.Score),
    weight = 1, opacity = 1, color = "white", dashArray = "3", fillOpacity = 0.75,
    highlightOptions = highlightOptions(weight = 3, color = "#444", fillOpacity = 0.9, bringToFront = TRUE),
    label = ~paste0("DeSO: ", desokod, " | MCDA: ", sprintf("%.3f", MCDA.Score)),
    popup = ~paste0(
      "<strong>DeSO Code: </strong>", desokod, "<br/>",
      "<hr style='margin:4px 0;'/>",
      "<strong>MCDA Score: </strong>", sprintf("%.3f", MCDA.Score), "<br/>",
      "<strong>NVDI_mean: </strong>", sprintf("%.3f", NVDI_mean), " (Norm: ", sprintf("%.3f", nvdi.norm.), ")<br/>",
      "<strong>NBDI_mean: </strong>", sprintf("%.3f", NBDI_mean), " (Norm: ", sprintf("%.3f", nbdi.norm), ")<br/>",
      "<strong>Income: </strong>", sprintf("%.2f", Income), " (Norm: ", sprintf("%.3f", income.norm), ")<br/>",
      "<strong>UHI_mean: </strong>", sprintf("%.2f", UHI_mean), " °C<br/>",
      "<strong>Dist_Water: </strong>", sprintf("%.1f", Dist_Water), " m"
    )
  ) %>%
  
  # Layer 2: UHI Intensity
  addPolygons(
    group = "UHI Intensity (°C)",
    fillColor = ~pal_uhi(UHI_mean),
    weight = 1, opacity = 1, color = "white", dashArray = "3", fillOpacity = 0.75,
    highlightOptions = highlightOptions(weight = 3, color = "#444", fillOpacity = 0.9, bringToFront = TRUE),
    label = ~paste0("DeSO: ", desokod, " | UHI: ", sprintf("%.2f", UHI_mean), " °C"),
    popup = ~paste0("<strong>DeSO Code: </strong>", desokod, "<br/><strong>UHI Mean: </strong>", sprintf("%.2f", UHI_mean), " °C")
  ) %>%
  
  # Layer 3: Vegetation (NDVI)
  addPolygons(
    group = "Vegetation (NDVI)",
    fillColor = ~pal_ndvi(NVDI_mean),
    weight = 1, opacity = 1, color = "white", dashArray = "3", fillOpacity = 0.75,
    highlightOptions = highlightOptions(weight = 3, color = "#444", fillOpacity = 0.9, bringToFront = TRUE),
    label = ~paste0("DeSO: ", desokod, " | NDVI: ", sprintf("%.3f", NVDI_mean)),
    popup = ~paste0("<strong>DeSO Code: </strong>", desokod, "<br/><strong>NDVI Mean: </strong>", sprintf("%.3f", NVDI_mean))
  ) %>%
  
  # Layer 4: Built Index (NBDI)
  addPolygons(
    group = "Built Index (NBDI)",
    fillColor = ~pal_nbdi(NBDI_mean),
    weight = 1, opacity = 1, color = "white", dashArray = "3", fillOpacity = 0.75,
    highlightOptions = highlightOptions(weight = 3, color = "#444", fillOpacity = 0.9, bringToFront = TRUE),
    label = ~paste0("DeSO: ", desokod, " | NBDI: ", sprintf("%.3f", NBDI_mean)),
    popup = ~paste0("<strong>DeSO Code: </strong>", desokod, "<br/><strong>NBDI Mean: </strong>", sprintf("%.3f", NBDI_mean))
  ) %>%
  
  # Layer 5: Income Level
  addPolygons(
    group = "Income Level",
    fillColor = ~pal_inc(Income),
    weight = 1, opacity = 1, color = "white", dashArray = "3", fillOpacity = 0.75,
    highlightOptions = highlightOptions(weight = 3, color = "#444", fillOpacity = 0.9, bringToFront = TRUE),
    label = ~paste0("DeSO: ", desokod, " | Income: ", sprintf("%.0f", Income)),
    popup = ~paste0("<strong>DeSO Code: </strong>", desokod, "<br/><strong>Income: </strong>", sprintf("%.2f", Income))
  ) %>%
  
  # Layer 6: Distance to Water
  addPolygons(
    group = "Dist. to Water (m)",
    fillColor = ~pal_water(Dist_Water),
    weight = 1, opacity = 1, color = "white", dashArray = "3", fillOpacity = 0.75,
    highlightOptions = highlightOptions(weight = 3, color = "#444", fillOpacity = 0.9, bringToFront = TRUE),
    label = ~paste0("DeSO: ", desokod, " | Dist. Water: ", sprintf("%.1f", Dist_Water), " m"),
    popup = ~paste0("<strong>DeSO Code: </strong>", desokod, "<br/><strong>Dist. Water: </strong>", sprintf("%.1f", Dist_Water), " m")
  ) %>%
  
  # Add Legends (Each marked with a unique class name)
  addLegend(pal = pal_mcda,  values = ~MCDA.Score,  opacity = 0.8, title = "MCDA Score",  position = "bottomright", className = "info legend leg-mcda") %>%
  addLegend(pal = pal_uhi,   values = ~UHI_mean,    opacity = 0.8, title = "UHI (°C)",    position = "bottomright", className = "info legend leg-uhi") %>%
  addLegend(pal = pal_ndvi,  values = ~NVDI_mean,   opacity = 0.8, title = "NDVI",        position = "bottomright", className = "info legend leg-ndvi") %>%
  addLegend(pal = pal_nbdi,  values = ~NBDI_mean,   opacity = 0.8, title = "NBDI",        position = "bottomright", className = "info legend leg-nbdi") %>%
  addLegend(pal = pal_inc,   values = ~Income,      opacity = 0.8, title = "Income",      position = "bottomright", className = "info legend leg-inc") %>%
  addLegend(pal = pal_water, values = ~Dist_Water,  opacity = 0.8, title = "Dist. Water", position = "bottomright", className = "info legend leg-water") %>%
  
  # Layer Controls Menu
  addLayersControl(
    baseGroups = c("MCDA Priority Score", "UHI Intensity (°C)", "Vegetation (NDVI)", "Built Index (NBDI)", "Income Level", "Dist. to Water (m)"),
    options = layersControlOptions(collapsed = FALSE)
  ) %>%
  
  # JavaScript to hide all inactive legends and show only the active one
  htmlwidgets::onRender("
    function(el, x) {
      var map = this;
      var legendClassMap = {
        'MCDA Priority Score': 'leg-mcda',
        'UHI Intensity (°C)': 'leg-uhi',
        'Vegetation (NDVI)': 'leg-ndvi',
        'Built Index (NBDI)': 'leg-nbdi',
        'Income Level': 'leg-inc',
        'Dist. to Water (m)': 'leg-water'
      };

      function syncLegends(layerName) {
        // Hide all legends
        Object.values(legendClassMap).forEach(function(cls) {
          var elms = document.getElementsByClassName(cls);
          for (var i = 0; i < elms.length; i++) {
            elms[i].style.display = 'none';
          }
        });
        // Show target legend
        var activeClass = legendClassMap[layerName];
        if (activeClass) {
          var activeElms = document.getElementsByClassName(activeClass);
          for (var j = 0; j < activeElms.length; j++) {
            activeElms[j].style.display = 'block';
          }
        }
      }

      // Initial state: show MCDA legend
      syncLegends('MCDA Priority Score');

      // Listen for base layer changes
      map.on('baselayerchange', function(e) {
        syncLegends(e.name);
      });
    }
  ")
